# System git config (/etc/gitconfig). System scope rather than ~/.gitconfig
# so the mixin ships nothing under /home and sbx's per-user rewrites can't
# clobber it; user-level settings still override.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictstyle = zdiff3
[url "https://github.com/"]
	insteadOf = git@github.com:
# What `git lfs install --system` writes.
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
